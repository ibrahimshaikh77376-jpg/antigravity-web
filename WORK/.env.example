# API Configuration
VITE_API_URL=https://script.google.com/macros/s/YOUR_GOOGLE_SCRIPT_ID/exec
VITE_BACKEND_URL=http://localhost:3000

# Telegram Bot Configuration
VITE_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
VITE_TELEGRAM_BOT_NAME=YOUR_BOT_NAME

# Feature Flags
VITE_ENABLE_DEMO=true
VITE_ENABLE_TRIAL=true
VITE_ENABLE_DEBUG=false

# Application Settings
VITE_APP_NAME=AI-ID Management
VITE_APP_VERSION=1.0.0

# Note: Copy this file to .env.local and fill in actual values
# .env.local will not be committed to git
